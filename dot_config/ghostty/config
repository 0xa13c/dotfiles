# Dynamic theme colors
  config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font
#  font-family = "JetBrainsMono Nerd Font"
#  font-style = Regular
#  font-size = 9
# -------- Fonts ---------
  font-family = "MonaspiceNeNerdFont"
  font-style = Light
  font-size = 10
# Slightly thicken font rendering (nice on low-DPI displays)
  font-thicken = true

# --- Theme & colors ---
# List all built-in themes: ghostty +list-themes
  config-file = ?auto/theme.ghostty
# theme = Novel
# Use different themes for system light/dark mode:
# theme = light:Builtin Solarized Light,dark:Birds Of Paradise
  background-opacity = 0.80
# Blur what's behind the window (needs compositor support)
  background-blur = true
# Minimum foreground/background contrast ratio (1 allows no contrast; 3 is more readable)
  minimum-contrast = 1
  gtk-toolbar-style = flat


# ------------------ Window -------------------

# Evenly balance padding on all sides
  window-padding-balance = true
  window-padding-x = 8
  window-padding-y = 8
# window-padding-x = 14
# window-padding-y = 14

# auto, none, client, server
  window-decoration = auto
# Reopen windows where they left off: default, never, always
  window-save-state = default
# New windows/tabs start in the current directory
  window-inherit-working-directory = true
# Window
  window-theme = ghostty 

# --- Behavior ---
# Copy selected text to both Linux's primary selection and regular clipboard
  copy-on-select = clipboard
# Ask before closing a window with a running process
  confirm-close-surface = true
  mouse-hide-while-typing = true
# Scrollback buffer size in bytes
  scrollback-limit = 10000000
# Shell integration powers title, working directory, and prompt tracking
  shell-integration = detect
  resize-overlay = never



# ------------------ Cursor --------------------
# block, bar, underline, block_hollow
  cursor-style = block_hollow
  cursor-style-blink = true 
# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
  shell-integration-features = no-cursor,ssh-env
# Keep the configured cursor shape instead of forcing a bar at shell prompts
# shell-integration-features = no-cursor
# Cursor styling
#  cursor-style = "block"
#  cursor-style-blink = false


# ----------------- Keybinds --------------------
# Format: keybind = trigger=action
# List all defaults: ghostty +list-keybinds
  keybind = shift+insert=paste_from_clipboard
  keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
  keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
  keybind = alt+shift+enter=csi:13;4u
  keybind = super+control+shift+alt+arrow_down=resize_split:down,100
  keybind = super+control+shift+alt+arrow_up=resize_split:up,100
  keybind = super+control+shift+alt+arrow_left=resize_split:left,100
  keybind = super+control+shift+alt+arrow_right=resize_split:right,100
  keybind = ctrl+shift+enter=new_split:right
  keybind = ctrl+shift+r=reload_config

# Slowdown mouse scrolling
  mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
  async-backend = epoll



