alias sudo='sudo '
alias _='sudo '
alias zshrc='nvim ~/.zshrc'
# shortcuts
alias c=clear
alias df="df -h "
alias pwgen="openssl rand -base64 24"
alias du='du -hd1|sort -h'
alias pingo="ping 8.8.8.8"
#cd back 
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
# git
alias lg=lazygit
alias gd=lazygit
alias vim=nvim
alias v=nvim
# Replace ls with eza
alias ls='eza'
# Common combinations
alias ll='eza -l --icons --git'
alias la='eza -la --icons --git'
alias lt='eza -T --icons --git-ignore'
alias l='eza -la'
#Git 
alias gc="git commit "
alias gs="git status "
