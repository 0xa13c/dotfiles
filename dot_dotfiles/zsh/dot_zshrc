# .zshrc 
#
# If you come from bash you might have to change your $PATH.
 export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
 #export ZSH="$HOME/.oh-my-zsh"


# sheldon — plugin manager (oh-my-zsh)
command -v sheldon > /dev/null && eval "$(sheldon source)"

# mise — version manager auto-switching for interactive shells
command -v mise > /dev/null && eval "$(mise activate zsh)"

# zoxide — smarter cd (replaces z). Provides `z` and `zi`.
command -v zoxide > /dev/null && eval "$(zoxide init zsh)"

command -v starship > /dev/null && eval "$(starship init zsh)"
#source 
# build array of environment config files for sourcing
#
typeset -ga sources
sources+="$HOME/.dotfiles/aliases.zsh"
sources+="$HOME/.atuin/bin/env" 
#sources+="$ZSH/oh-my-zsh.sh"
#
# include sources
#
foreach file (`echo $sources`)
    if [[ -a $file ]]; then
        source $file
    fi
end

#Config Atuin 
command -v atuin > /dev/null && eval "$(atuin init zsh)"

# User configuration

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
 if [[ -n $SSH_CONNECTION ]]; then
   export EDITOR='nvim'
 else
   export EDITOR='nvim'
 fi

# Compilation flags
 export ARCHFLAGS="-arch $(uname -m)"

# Example aliases
 alias zshconfig="nvim ~/.zshrc"
# alias ohmyzsh="nvim ~/.oh-my-zsh" 
#
# ----------------------------------------------------------------
# HELPERS
# ----------------------------------------------------------------
# Avoid duplicating entry "$1" whenever add it to "$PATH"
function add_to_PATH {
  case ":$PATH:" in
    *":$1:"*) :;;           # already there.
    *) PATH="$1:$PATH";;    # prefer custom $1 first.
  esac
}

# ----------------------------------------------------------------
# ALIASES
# ----------------------------------------------------------------
# alias ls=lsd
# alias grep=rg
 alias find=fd
# alias diff=delta
alias lg=lazygit
alias vim=nvim

# ----------------------------------------------------------------
# ENVIRONMENTS
# ----------------------------------------------------------------
add_to_PATH "$HOME/.local/bin"
add_to_PATH "$HOME/bin/"
add_to_PATH "$HOME/Apps"
add_to_PATH "$HOME/.bin"
# add_to_PATH "$HOME/.
# PNPM.
#export PNPM_HOME="$HOME/.local/share/pnpm"
#add_to_PATH "$PNPM_HOME"

# Yarn.
add_to_PATH "$(yarn global bin)"

